{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "files": {
    "includes": ["src/**/*.{ts,tsx,css}", "*.{ts,json}"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "useButtonType": "off",
        "useAriaPropsSupportedByRole": "off"
      },
      "correctness": { "useExhaustiveDependencies": "off" },
      "suspicious": { "noArrayIndexKey": "off" },
      "style": { "noDescendingSpecificity": "off" }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  }
}
